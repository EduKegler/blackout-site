---
import site from '../../site.config.json';
import '../styles/global.css';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [['Início', `${base}/`], ['Suporte', `${base}/support/`], ['Privacidade', `${base}/privacy/`]];
const draft = !site.publicationApproved || !site.privacyReviewed || !site.email || !site.responsible;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {draft && <meta name="robots" content="noindex, nofollow" />}
    <title>{title} | Blackout.io</title>
  </head>
  <body>
    <a class="skip" href="#content">Pular para o conteúdo</a>
    {draft && <aside class="draft">Prévia local. Contato e política aguardam revisão antes da publicação.</aside>}
    <header class="shell header">
      <a class="brand" href={`${base}/`} aria-label="Blackout.io, início"><span class="mark" aria-hidden="true"></span>Blackout.io</a>
      <nav aria-label="Navegação principal">
        {links.map(([label, href]) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}
      </nav>
    </header>
    <main id="content" class="shell" tabindex="-1"><slot /></main>
    <footer class="shell footer">
      <span>Blackout.io · iPhone e iPad</span>
      <a href={`${base}/privacy/`}>Política de privacidade</a>
    </footer>
  </body>
</html>
