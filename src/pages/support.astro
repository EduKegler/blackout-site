---
import Page from '../layouts/Page.astro';
import site from '../../site.config.json';
---
<Page title="Support" description="Contact for Voidy on iPhone and iPad." other="/pt/support/">
  <article class="prose">
    <p class="eyebrow">Help with the game</p><h1>Support</h1>
    <section><h2>Contact us</h2>
      <p><a class="contact" href={`mailto:${site.email}`}>{site.email}</a></p>
      <p>Include your device model, the iOS or iPadOS version, the game version and the steps to the problem. Do not send passwords or documents.</p>
      <p>Settings are under the gear in the menu. See the <a href="/privacy/">privacy policy</a> for your data.</p>
    </section>
  </article>
</Page>
